---
import '../styles/global.css';
import BaseballCard from '../components/BaseballCard.svelte';
import { profileData } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title = profileData.name, description = profileData.bio } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script is:inline>
      const THEME_TTL_MS = 12 * 60 * 60 * 1000;
      const storedValue = localStorage.getItem('theme');
      const storedAt = Number(localStorage.getItem('themeSetAt'));
      const stillValid = storedValue && storedAt && Date.now() - storedAt <= THEME_TTL_MS;
      const isDark = stillValid
        ? storedValue === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', isDark);
    </script>
    <style is:global>
      @keyframes card-in {
        from { opacity: 0; translate: 0 12px; }
        to   { opacity: 1; translate: 0 0; }
      }
      .bio-card      { animation: card-in 0.4s ease-out both; }
      .presence-card { animation: card-in 0.5s ease-out both; }
      .project-card  { animation: card-in 0.55s ease-out both; }
      .presence-card:nth-child(n+2)  { animation-delay: 0.04s; }
      .presence-card:nth-child(n+3)  { animation-delay: 0.08s; }
      .presence-card:nth-child(n+4)  { animation-delay: 0.12s; }
      .presence-card:nth-child(n+5)  { animation-delay: 0.16s; }
      .presence-card:nth-child(n+6)  { animation-delay: 0.2s;  }
      .presence-card:nth-child(n+7)  { animation-delay: 0.24s; }
      .presence-card:nth-child(n+8)  { animation-delay: 0.28s; }
      .presence-card:nth-child(n+9)  { animation-delay: 0.32s; }
      .presence-card:nth-child(n+10) { animation-delay: 0.36s; }
      .project-card:nth-child(n+2)   { animation-delay: 0.06s; }
      .project-card:nth-child(n+3)   { animation-delay: 0.12s; }
      .project-card:nth-child(n+4)   { animation-delay: 0.18s; }
      .project-card:nth-child(n+5)   { animation-delay: 0.24s; }
      .project-card:nth-child(n+6)   { animation-delay: 0.3s;  }

      #junji-overlay {
        background: repeating-linear-gradient(
          0deg,
          transparent 0px, transparent 4px,
          rgba(0,0,0,0.12) 4px, rgba(0,0,0,0.12) 6px
        );
        mix-blend-mode: multiply;
      }
      .dark #junji-overlay {
        background: repeating-linear-gradient(
          0deg,
          transparent 0px, transparent 4px,
          rgba(255,255,255,0.07) 4px, rgba(255,255,255,0.07) 6px
        );
        mix-blend-mode: screen;
      }
      body.junji-on .bg-background { background-color: transparent !important; }
      html:not(.dark) body.junji-on { background-color: hsl(0 0% 92%); }

      /* Peel page animations */
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-up { animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards; }
      [data-delay="0s"]    { animation-delay: 0s; }
      [data-delay="0.15s"] { animation-delay: 0.15s; }
      [data-delay="0.3s"]  { animation-delay: 0.3s; }
      [data-delay="0.45s"] { animation-delay: 0.45s; }
      [data-delay="0.6s"]  { animation-delay: 0.6s; }

      .icon-tilt { display: inline-block; transition: transform 0.15s ease-out; }
      .macos-icon {
        position: relative;
        display: inline-block;
        border-radius: 22.5%;
        overflow: hidden;
        border: 1px solid hsl(var(--border));
      }
      .macos-icon::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(150deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.04) 30%, transparent 55%);
        pointer-events: none;
      }
      .icon-invert { filter: brightness(0) saturate(100%); }
      .dark .icon-invert { filter: brightness(0) invert(1); }
      .icon-button-primary { filter: brightness(0) invert(1); }
      .dark .icon-button-primary { filter: brightness(0) saturate(100%); }

      .screenshot-flowout {
        -webkit-mask-image: linear-gradient(to top, transparent 15%, black 45%);
                mask-image: linear-gradient(to top, transparent 15%, black 45%);
      }

      .pro-badge {
        background-image: linear-gradient(
          to bottom,
          color-mix(in oklab, AccentColor 100%, white 12%),
          color-mix(in oklab, AccentColor 100%, black 10%)
        );
        box-shadow: 0 10px 15px -3px color-mix(in oklab, AccentColor 30%, transparent),
                    0 4px 6px -4px color-mix(in oklab, AccentColor 30%, transparent);
      }
      @supports not (background: AccentColor) {
        .pro-badge {
          background-image: linear-gradient(to bottom, hsl(217 91% 60%), hsl(217 91% 52%));
          box-shadow: 0 10px 15px -3px hsl(217 91% 60% / 0.3),
                      0 4px 6px -4px hsl(217 91% 60% / 0.3);
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased relative">
    <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
      <defs>
        <filter id="junji-filter" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feColorMatrix type="saturate" values="0" result="gray"/>
          <feComponentTransfer in="gray" result="boosted">
            <feFuncR type="linear" slope="1.5" intercept="-0.25"/>
            <feFuncG type="linear" slope="1.5" intercept="-0.25"/>
            <feFuncB type="linear" slope="1.5" intercept="-0.25"/>
          </feComponentTransfer>
          <feTurbulence id="junji-turbulence" type="turbulence" baseFrequency="0.03 0.08" numOctaves="2" seed="5" result="glitch-map"/>
          <feDisplacementMap id="junji-disp" in="boosted" in2="glitch-map" scale="0" xChannelSelector="R" yChannelSelector="G" result="displaced"/>
          <feComponentTransfer in="displaced">
            <feFuncR type="linear" slope="1.05" intercept="-0.02"/>
            <feFuncG type="linear" slope="1.05" intercept="-0.02"/>
            <feFuncB type="linear" slope="1.05" intercept="-0.02"/>
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <div id="junji-overlay" class="fixed inset-0 pointer-events-none z-[100] hidden"></div>
    <canvas id="junji-spiral" class="fixed inset-0 pointer-events-none z-[1] hidden"></canvas>

    <div id="content-root" class="relative z-10">
      <div class="min-h-screen desktop:flex desktop:justify-center">
        <div class="desktop:flex desktop:w-full desktop:max-w-screen-2xl">

          <!-- Desktop aside (sticky) -->
          <aside class="hidden desktop:flex sticky top-0 h-screen shrink-0 px-10 py-12 flex-col justify-between bg-background">
            <div class="flex flex-col gap-6">
              <div class="h-20"></div>
              <a href="/" aria-label="Home" class="block">
                <BaseballCard
                  name={profileData.name}
                  bio={profileData.bio}
                  avatar={profileData.avatar}
                />
              </a>
            </div>
            <div class="mt-auto pt-8 flex items-center gap-4">
              <button class="theme-btn text-foreground/60 hover:text-foreground transition-colors" aria-label="Toggle theme">
                <svg class="hidden dark:block w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
                </svg>
                <svg class="block dark:hidden w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/>
                </svg>
              </button>
              <button class="junji-btn text-foreground/60 hover:text-foreground transition-colors" aria-label="Toggle Junji Ito mode">
                <svg class="junji-icon-off w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 11a2 2 0 1 1-4 0 4 4 0 0 1 8 0 6 6 0 0 1-12 0 8 8 0 0 1 16 0 10 10 0 1 1-20 0 11.93 11.93 0 0 1 2.42-7.22 2 2 0 1 1 3.16 2.44"/>
                </svg>
                <svg class="junji-icon-on hidden w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 4h3a2 2 0 0 1 2 2v14"/>
                  <path d="M2 20h3"/>
                  <path d="M13 20h9"/>
                  <path d="M10 12v.01"/>
                  <path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/>
                </svg>
              </button>
              <a href="/contact" class="text-foreground/60 hover:text-foreground transition-colors" aria-label="Contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </a>
              <a href="/privacy" class="text-foreground/60 hover:text-foreground transition-colors" aria-label="Privacy">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18a2 2 0 0 0-4 0"/><path d="m19 11-2.11-6.657a2 2 0 0 0-2.752-1.148l-1.276.61A2 2 0 0 1 12 4H8.5a2 2 0 0 0-1.925 1.456L5 11"/><path d="M2 11h20"/><circle cx="17" cy="18" r="3"/><circle cx="7" cy="18" r="3"/></svg>
              </a>
              <p class="text-sm text-muted-foreground">© {new Date().getFullYear()} {profileData.name}</p>
            </div>
          </aside>

          <!-- Mobile header -->
          <header class="desktop:hidden p-8 bg-background max-w-lg w-full mx-auto">
            <a href="/" aria-label="Home" class="block">
              <BaseballCard
                name={profileData.name}
                bio={profileData.bio}
                avatar={profileData.avatar}
                mobile={true}
              />
            </a>
          </header>

          <!-- Main content (slot) -->
          <main class="flex-1 bg-background">
            <div class="mx-auto w-full max-w-lg desktop:max-w-4xl px-4 desktop:px-12 py-8 desktop:py-12">
              <div class="hidden desktop:block h-12"></div>
              <slot />
            </div>
          </main>

          <!-- Mobile footer -->
          <footer class="desktop:hidden p-4 bg-background max-w-lg w-full mx-auto">
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-end gap-3">
                <button class="theme-btn text-foreground/60 hover:text-foreground transition-colors" aria-label="Toggle theme">
                  <svg class="hidden dark:block w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
                  </svg>
                  <svg class="block dark:hidden w-6 h-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/>
                  </svg>
                </button>
                <button class="junji-btn text-foreground/60 hover:text-foreground transition-colors" aria-label="Toggle Junji Ito mode">
                  <svg class="junji-icon-off w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 11a2 2 0 1 1-4 0 4 4 0 0 1 8 0 6 6 0 0 1-12 0 8 8 0 0 1 16 0 10 10 0 1 1-20 0 11.93 11.93 0 0 1 2.42-7.22 2 2 0 1 1 3.16 2.44"/>
                  </svg>
                  <svg class="junji-icon-on hidden w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 4h3a2 2 0 0 1 2 2v14"/>
                    <path d="M2 20h3"/>
                    <path d="M13 20h9"/>
                    <path d="M10 12v.01"/>
                    <path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/>
                  </svg>
                </button>
                <a href="/contact" class="text-foreground/60 hover:text-foreground transition-colors" aria-label="Contact">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </a>
                <a href="/privacy" class="text-foreground/60 hover:text-foreground transition-colors" aria-label="Privacy">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18a2 2 0 0 0-4 0"/><path d="m19 11-2.11-6.657a2 2 0 0 0-2.752-1.148l-1.276.61A2 2 0 0 1 12 4H8.5a2 2 0 0 0-1.925 1.456L5 11"/><path d="M2 11h20"/><circle cx="17" cy="18" r="3"/><circle cx="7" cy="18" r="3"/></svg>
                </a>
              </div>
              <p class="text-sm text-muted-foreground">© {new Date().getFullYear()} {profileData.name}</p>
            </div>
          </footer>

        </div>
      </div>
    </div>

    <script>
      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        localStorage.setItem('themeSetAt', String(Date.now()));
      }
      document.querySelectorAll('.theme-btn').forEach((btn) => btn.addEventListener('click', toggleTheme));
    </script>

    <script>
      import gsap from 'gsap';

      function addMagnetic(selector: string, strength: number) {
        document.querySelectorAll<HTMLElement>(selector).forEach((card) => {
          const xTo = gsap.quickTo(card, 'x', { duration: 0.4, ease: 'power3.out' });
          const yTo = gsap.quickTo(card, 'y', { duration: 0.4, ease: 'power3.out' });

          card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            xTo((e.clientX - r.left - r.width  / 2) * strength);
            yTo((e.clientY - r.top  - r.height / 2) * strength);
          });
          card.addEventListener('mouseleave', () => { xTo(0); yTo(0); });
        });
      }

      addMagnetic('.bio-card',      0.08);
      addMagnetic('.presence-card', 0.2);
      addMagnetic('.project-card',  0.1);

      document.querySelectorAll('.project-card').forEach((card) => {
        const title = card.querySelector('.card-title') as HTMLElement | null;
        if (!title) return;
        const wrapper = title.parentElement as HTMLElement;

        card.addEventListener('mouseenter', () => {
          const overflow = title.scrollWidth - wrapper.clientWidth;
          if (overflow > 2) {
            gsap.to(title, {
              x: -overflow,
              duration: overflow / 40,
              ease: 'none',
              delay: 0.4,
            });
          }
        });

        card.addEventListener('mouseleave', () => {
          gsap.killTweensOf(title);
          gsap.to(title, { x: 0, duration: 0.3, ease: 'power2.out' });
        });
      });
    </script>

    <script>
      let junjiActive = false;
      let glitchTimer: ReturnType<typeof setInterval> | null = null;
      let spiralRaf: number | null = null;
      let spiralStart = 0;

      const contentRoot = document.getElementById('content-root') as HTMLElement;
      const filterTargets = Array.from(
        contentRoot.querySelectorAll<HTMLElement>(
          'main section, main article, .bio-card, footer, aside > .mt-auto'
        )
      );
      const overlay    = document.getElementById('junji-overlay')   as HTMLElement;
      const turbulence = document.getElementById('junji-turbulence') as unknown as SVGFETurbulenceElement;
      const disp       = document.getElementById('junji-disp')       as unknown as SVGFEDisplacementMapElement;
      const spiral     = document.getElementById('junji-spiral')     as HTMLCanvasElement;
      const spiralCtx  = spiral.getContext('2d')!;

      function resizeSpiral() {
        const w = window.innerWidth, h = window.innerHeight;
        spiral.width  = w;
        spiral.height = h;
      }

      function drawSpiral(tSec: number) {
        const w = spiral.width, h = spiral.height;
        let cx = w / 2, cy = h / 2;
        for (const b of document.querySelectorAll<HTMLElement>('.bio-card')) {
          const r = b.getBoundingClientRect();
          if (r.width > 0 && r.height > 0) {
            cx = r.left + r.width  / 2;
            cy = r.top  + r.height / 2;
            break;
          }
        }
        const isDark = document.documentElement.classList.contains('dark');
        spiralCtx.clearRect(0, 0, w, h);
        spiralCtx.lineWidth = 6;

        const rotation = tSec * 4.0;
        const pulse    = 1 + Math.sin(tSec * 0.6) * 0.03;
        const maxR     = Math.hypot(w, h) * 0.75 * pulse;
        const turns    = 14;
        const totalTh  = turns * Math.PI * 2;
        const steps    = 1400;
        const b        = maxR / totalTh;

        const ink = isDark ? '255,255,255' : '0,0,0';
        const grad = spiralCtx.createRadialGradient(cx, cy, 0, cx, cy, maxR);
        grad.addColorStop(0,   `rgba(${ink},0)`);
        grad.addColorStop(0.2, `rgba(${ink},0.07)`);
        grad.addColorStop(1,   `rgba(${ink},0.14)`);
        spiralCtx.strokeStyle = grad;

        spiralCtx.beginPath();
        for (let i = 0; i <= steps; i++) {
          const theta = (i / steps) * totalTh;
          const r = b * theta;
          const a = theta + rotation;
          const x = cx + Math.cos(a) * r;
          const y = cy + Math.sin(a) * r;
          if (i === 0) spiralCtx.moveTo(x, y);
          else spiralCtx.lineTo(x, y);
        }
        spiralCtx.stroke();
      }

      function spiralTick(now: number) {
        if (!junjiActive) return;
        drawSpiral((now - spiralStart) / 1000);
        spiralRaf = requestAnimationFrame(spiralTick);
      }

      function resetPrimitives() {
        turbulence.setAttribute('seed', '5');
        turbulence.setAttribute('baseFrequency', '0.03 0.08');
        disp.setAttribute('scale', '0');
      }

      function junjTick() {
        if (!junjiActive) return;
        if (Math.random() < 0.25) {
          turbulence.setAttribute('seed', String(Math.floor(Math.random() * 999)));
          turbulence.setAttribute(
            'baseFrequency',
            `${(0.01 + Math.random() * 0.06).toFixed(4)} ${(0.05 + Math.random() * 0.13).toFixed(4)}`
          );
          disp.setAttribute('scale', String(Math.round(6 + Math.random() * 16)));
        } else {
          resetPrimitives();
        }
      }

      function toggleJunji() {
        junjiActive = !junjiActive;
        for (const t of filterTargets) {
          t.style.filter    = junjiActive ? 'url(#junji-filter)' : '';
          t.style.willChange = junjiActive ? 'filter' : '';
        }
        overlay.classList.toggle('hidden', !junjiActive);
        spiral.classList.toggle('hidden', !junjiActive);
        document.body.classList.toggle('junji-on', junjiActive);

        if (junjiActive) {
          glitchTimer = setInterval(junjTick, 80);
          resizeSpiral();
          window.addEventListener('resize', resizeSpiral);
          spiralStart = performance.now();
          spiralRaf = requestAnimationFrame(spiralTick);
        } else {
          clearInterval(glitchTimer!);
          glitchTimer = null;
          resetPrimitives();
          if (spiralRaf !== null) cancelAnimationFrame(spiralRaf);
          spiralRaf = null;
          window.removeEventListener('resize', resizeSpiral);
          spiralCtx.clearRect(0, 0, spiral.width, spiral.height);
        }

        document.querySelectorAll<HTMLElement>('.junji-btn').forEach((btn) => {
          btn.querySelector<HTMLElement>('.junji-icon-off')?.classList.toggle('hidden', junjiActive);
          btn.querySelector<HTMLElement>('.junji-icon-on')?.classList.toggle('hidden', !junjiActive);
        });

        localStorage.setItem('junji', junjiActive ? 'on' : 'off');
        localStorage.setItem('junjiSetAt', String(Date.now()));
      }

      document.querySelectorAll('.junji-btn').forEach((btn) =>
        btn.addEventListener('click', toggleJunji)
      );

      const JUNJI_TTL_MS = 12 * 60 * 60 * 1000;
      const junjiSetAt = Number(localStorage.getItem('junjiSetAt'));
      const junjiStillValid = junjiSetAt && Date.now() - junjiSetAt <= JUNJI_TTL_MS;
      if (localStorage.getItem('junji') === 'on' && junjiStillValid) {
        toggleJunji();
      }
    </script>
  </body>
</html>
