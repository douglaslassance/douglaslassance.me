---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Card from '$lib/components/ui/card/card.svelte';
import FeatureCard from './AppFeatureCard.svelte';
import CopyButton from './CopyButton.svelte';
import { buttonVariants } from '$lib/components/ui/button';
import { badgeVariants } from '$lib/components/ui/badge';

type Feature = { icon: string; title: string; description: string; pro?: boolean };

interface Props {
  name: string;
  description: string;
  iconSrc: string;
  iconAlt?: string;
  screenshotLight?: ImageMetadata;
  screenshotDark?: ImageMetadata;
  screenshotAlt?: string;
  heroTagline: string;
  features: Feature[];
  brewCommand: string;
  appStoreUrl?: string;
  apiSlug: string;
  proUrl?: string;
}

const {
  name,
  description,
  iconSrc,
  iconAlt = `${Astro.props.name} app icon`,
  screenshotLight,
  screenshotDark,
  screenshotAlt = `${Astro.props.name} screenshot`,
  heroTagline,
  features,
  brewCommand,
  appStoreUrl,
  apiSlug,
  proUrl,
} = Astro.props;
---

<Layout title={name} description={description}>
  <section class="flex justify-center pt-8 desktop:pt-0">
    <div class="project-card flex items-center gap-8">
      <div class="macos-icon shrink-0">
        <img src={iconSrc} alt={iconAlt} class="w-[120px] h-[120px] desktop:w-[160px] desktop:h-[160px] block" />
      </div>
      <div class="flex flex-col items-start">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">{name}</h1>
        <span class:list={['mt-1', badgeVariants({ variant: 'secondary' })]}>
          <div
            class="w-3 h-3 opacity-60 flex-shrink-0"
            style="-webkit-mask-image: url(/website.svg); mask-image: url(/website.svg); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; background-color: var(--foreground);"
          ></div>
          App
        </span>
      </div>
    </div>
  </section>

  <section class={`w-full ${screenshotLight ? 'mt-8' : 'mt-20'}`}>
    <div class="project-card mb-6">
      {screenshotLight && (
        <div class="screenshot-flowout relative z-10 -mb-[180px] desktop:-mb-[260px]">
          <Picture
            src={screenshotLight}
            alt={screenshotAlt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[400, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 800px, 100vw"
            pictureAttributes={{ class: 'block dark:hidden' }}
            class="w-full h-auto"
          />
          {screenshotDark && <Picture
            src={screenshotDark}
            alt={screenshotAlt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[400, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 800px, 100vw"
            pictureAttributes={{ class: 'hidden dark:block' }}
            class="w-full h-auto"
          />}
        </div>
      )}
      <Card>
        <div class={`flex flex-col p-4 gap-3${screenshotLight ? ' pt-[130px] desktop:pt-[180px]' : ''}`}>
          <div class="flex items-center gap-2">
            <span class="inline-flex w-4 h-4 shrink-0 items-center justify-center text-foreground/50" aria-hidden="true">
              <slot name="hero-icon" />
            </span>
            <h2 class="text-sm font-semibold leading-none">{heroTagline}</h2>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
        </div>
      </Card>
    </div>

    <div class="grid grid-cols-1 desktop:grid-cols-2 gap-4 desktop:gap-6">
      {features.map((f) => (
        <FeatureCard icon={f.icon as any} title={f.title} description={f.description} pro={f.pro} proUrl={proUrl} appName={name} />
      ))}
    </div>
  </section>

  <section class="w-full mt-16">
    <div class="text-center max-w-2xl mx-auto">
      {appStoreUrl && (
        <div class="flex justify-center mb-6">
          <a
            href={appStoreUrl}
            target="_blank"
            rel="noopener"
            aria-label={`Download ${name} on the App Store (opens in new window)`}
            class:list={[buttonVariants({ size: 'lg' })]}
          >
            <img src="/apple.svg" alt="" aria-hidden="true" class="w-4 h-4 icon-button-primary" />
            Download on App Store
          </a>
        </div>
      )}
      <h2 class="text-sm font-medium text-muted-foreground mb-3">
        {appStoreUrl ? 'or install with' : 'Install with'} <a href="https://brew.sh/" class="text-foreground underline underline-offset-4 decoration-foreground/30 hover:decoration-foreground transition-colors">Homebrew</a>
      </h2>
      <div class="flex items-center justify-between bg-card border border-border rounded-lg px-4 py-3 mx-auto max-w-lg">
        <code class="flex-1 text-left font-mono text-sm">{brewCommand}</code>
        <CopyButton client:load text={brewCommand} />
      </div>
      <p class="mt-3 text-sm text-muted-foreground/60">
        or download directly <a id="dmg-link" href="#" class="underline underline-offset-4 decoration-foreground/30 hover:decoration-foreground transition-colors">here</a>.
      </p>
    </div>
  </section>

  <section class="mt-16">
    <div class="flex flex-col desktop:flex-row desktop:justify-between gap-2 desktop:gap-4 text-center desktop:text-left">
      <p class="text-sm text-muted-foreground">
        App icon by <a href="https://www.milescorless.com/" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-foreground/20 hover:decoration-foreground transition-colors">Miles Corless</a>.
      </p>
      <slot name="credits" />
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ apiSlug }}>
  fetch(`https://api.douglaslassance.me/${apiSlug}`)
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (!data?.latest) return;
      const link = document.getElementById('dmg-link');
      if (link) link.href = `https://api.douglaslassance.me/${apiSlug}/download/${data.latest}/aarch64-apple-darwin`;
    })
    .catch(() => {});
</script>
