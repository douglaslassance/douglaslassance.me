---
import AppPage from '../../components/AppPage.astro';

const description = "Rollpaper turns your wallpaper into a social feed viewer. Passively stay on top of what interests you, turning a completely static space into something connected to the rest of the world.";

const features = [
  { icon: 'rss',      title: 'Your favorite feeds',            description: "Pulls images from the good guys. Mastodon users, Bluesky feeds, subreddits, it's all supported." },
  { icon: 'calendar', title: 'Switch on schedule',              description: 'Rotate every few minutes, hourly, or daily, whatever rhythm fits your day.' },
  { icon: 'sparkles', title: 'Upscale low-resolution content',  description: 'Images below your display resolution get upscaled automatically, so nothing looks soft or stretched.', pro: true },
  { icon: 'eye',      title: "Filter content you don't like",   description: "Not everything will feel good as wallpaper, flag what you don't want to see again.", pro: true },
];
---

<AppPage
  name="Rollpaper"
  description={description}
  iconSrc="/rollpaper/icon.png"
  heroTagline="Turn 90% of your screen into something useful"
  features={features}
  brewCommand="brew install douglaslassance/tap/rollpaper"
  apiSlug="rollpaper"
>
  <svg slot="hero-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
</AppPage>
