          {profileData.professionalProjects.map((project) => (
            <ProfessionalProjectCard
              title={project.title}
              category={project.category}
              description={project.description}
              url={project.url}
              image={project.image}
              type={project.type}
            />
          ))}
          </div>
        </section>
      </main>

      <!-- Mobile Footer -->
