---
import '../styles/global.css';
import BaseballCard from '../components/BaseballCard.svelte';
import PresenceCard from '../components/PresenceCard.svelte';
import ProfessionalProjectCard from '../components/ProfessionalProjectCard.svelte';
import ProjectCard from '../components/ProjectCard.svelte';

type ProjectType = 'youtube' | 'instagram' | 'website' | 'github' | 'steam' | 'fab' | 'company' | 'homebrew';

interface Project {
  title: string;
  category: string;
