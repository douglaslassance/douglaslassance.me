    { title: "Sigg Jones", category: "Animated Short", description: "A story of brawl and bromance", url: "https://youtu.be/TE86DR8E0LI", image: "https://i.ytimg.com/vi/TE86DR8E0LI/mqdefault.jpg", type: "youtube" },
