---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.svelte';

const description = "Get in touch with Douglas Lassance.";
---

<Layout title="Contact" description={description}>
  <article>
    <h1 class="scroll-m-20 border-b border-border pb-2 text-xl font-semibold">Get in touch with me</h1>

    <div class="mt-8">
      <ContactForm client:load />
    </div>
  </article>
</Layout>
