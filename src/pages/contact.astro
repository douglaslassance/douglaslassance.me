---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.svelte';

const description = "Get in touch with Douglas Lassance.";
---

<Layout title="Contact" description={description}>
  <article>
    <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight text-balance">Contact</h1>
    <p class="text-muted-foreground text-sm mt-2">Let's get in touch!</p>

    <div class="mt-12">
      <ContactForm client:load />
    </div>
  </article>
</Layout>
