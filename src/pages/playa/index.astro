---
import AppPage from '../../components/AppPage.astro';
import icon from '../../../art/playa/icon.png';
import screenshotLight from '../../../art/playa/screenshot-light.png';
import screenshotDark from '../../../art/playa/screenshot-dark.png';

const description = "Playa presents the music you already own. Point it at a folder and enjoy organized files with covers and fast search.";

const features = [
  { icon: 'search',         title: 'Powerful search',       description: 'Full text across titles, artists, albums, composers, and genres, narrowing the library as you type.' },
  { icon: 'list-music',     title: 'Smart playlists',       description: 'Rules over any tag or library field, with limits. The 25 most played jazz tracks added this year, always current.' },
  { icon: 'cloud-download', title: 'Bandcamp built in',     description: 'Your purchases sit in the library as ordinary albums, and the audio is fetched the first time you press play.' },
  { icon: 'disc',           title: 'DJs will like it too',  description: 'Your library doubles as a rekordbox database, so tracks and playlists open straight in rekordbox and on CDJs with no export step.', pro: true },
];
---

<AppPage
  name="Playa"
  description={description}
  iconSrc={icon}
  screenshotLight={screenshotLight}
  screenshotDark={screenshotDark}
  screenshotAlt="Playa app showing the playlists sidebar, a grid of album covers, and the playback bar"
  heroTagline="Enjoy your local music"
  features={features}
  brewCommand="brew install douglaslassance/tap/playa"
  apiSlug="playa"
>
  <svg slot="hero-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10v3"/><path d="M6 6v11"/><path d="M10 3v18"/><path d="M14 8v7"/><path d="M18 5v13"/><path d="M22 10v3"/></svg>
</AppPage>
